# UnoSure Agent Portal — Environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to version control.

# Backend API base URL (server-side only — no NEXT_PUBLIC_ prefix)
BASE_URL=https://dev-one-insurance.intel-soln.com.ph/api/v1

# Same URL exposed to the browser (for the Axios client instance)
NEXT_PUBLIC_BASE_URL=https://dev-one-insurance.intel-soln.com.ph/api/v1

# Public storefront (ecommerce app) base URL used for agent referral links
NEXT_PUBLIC_ECOMMERCE_URL=https://oneinsurance.shop

# Canonical origin of this app — used to restrict CORS on all /api/* routes.
# Set to the deployed URL in production (e.g. https://agent.oneinsurance.shop).
# Defaults to http://localhost:4000 if not set.
APP_URL=http://localhost:4000
