# =============================================================================
# ONE INSURANCE — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in the values. Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend API (server-side only — NO NEXT_PUBLIC_ prefix)
# Used exclusively inside src/app/api/** Route Handlers (BFF layer).
# Never expose these to the browser.
#
# BACKEND_TOKEN authenticates all BFF → OI-backend calls, including:
#   - GET  /api/v1/travel/full-quote/{proposalNumber}  (resumption check)
#   - POST /quote/travel/load-quote                    (full proposal load)
#   - POST /travel/issue-quote                         (policy issuance)
#
# The OI backend holds its own IGW_CLIENT_ID / IGW_CLIENT_SECRET to talk to
# the underwriter gateway.  You do NOT need to set IGW credentials here — the
# BFF never contacts the IGW directly.  If the IGW is unreachable, the backend
# returns state=unavailable (503) and the FE will offer a retry.
# -----------------------------------------------------------------------------
BASE_URL=https://your-backend.example.com/api/v1

# -----------------------------------------------------------------------------
# Payment Gateway (server-side only)
# -----------------------------------------------------------------------------
PAYMENT_BASE_URL=https://payment-gateway.example.com
PAYMENT_CLIENT_ID=your-client-id
PAYMENT_CLIENT_SECRET=your-client-secret
MERCHANT_ACCOUNT_ID=your-merchant-account-id
# Service code issued by DLT — required for brands and submit endpoints (DLT v1.3+)
PAYMENT_SERVICE_CODE=APN-COLLECTION

# Secret key for AES-256 encryption of cached payment tokens.
# Generate with: openssl rand -hex 32
SECRET_KEY=your-64-char-hex-secret-key

# -----------------------------------------------------------------------------
# Public — safe to expose to the browser
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Laravel Reverb / WebSocket (public keys only — client needs these to connect)
# The APP_SECRET must NOT have a NEXT_PUBLIC_ prefix — keep it server-side.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_REVERB_APP_ID=your-reverb-app-id
NEXT_PUBLIC_REVERB_APP_KEY=your-reverb-app-key
NEXT_PUBLIC_REVERB_HOST=your-reverb-host
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https

# ── Product availability flags (public — read on client & server) ──────────────
NEXT_PUBLIC_PRODUCT_TRAVEL=true
NEXT_PUBLIC_PRODUCT_MOTOR=true
NEXT_PUBLIC_PRODUCT_HEALTH=true

# ── Backend availability (server-side only) ────────────────────────────────────
# Set to "true" to skip the health check and always show the holding page.
BACKEND_OFFLINE=false
